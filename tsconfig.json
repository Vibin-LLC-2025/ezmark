{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleDetection": "force",
    "skipLibCheck": false
  },
  "include": ["ui/**/*.js", "crates/app/harness/**/*.js", "types/**/*.d.ts"],
  "exclude": ["ui/vendor/**"]
}
