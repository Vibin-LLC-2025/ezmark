root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# Spec files and saved pipeline output are compared byte for byte. Their
# trailing spaces and tabs are part of the test.
[tests/{spec,pipeline}/*.{txt,snap}]
trim_trailing_whitespace = false
indent_style = unset
